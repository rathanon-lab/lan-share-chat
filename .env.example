# LAN Share Chat v3.0 Configuration (Pure HTTP Backend for Direct LAN or Reverse Proxy)
# Copy this file to .env and fill in strong secrets before running in production.

PORT=3000
NODE_ENV=development

# Reverse Proxy / Domain Integration (Recommended with Nginx Proxy Manager + Internal DNS)
# PUBLIC_HOST=chat.lab.lan
# PUBLIC_HTTPS_URL=https://chat.lab.lan

# Optional Legacy Standalone Self-Signed HTTPS (default: disabled; let Reverse Proxy handle TLS)
# ENABLE_LOCAL_HTTPS=1
# HTTPS_PORT=3443

# Strong secret password for /admin dashboard (required in production)
ADMIN_PASSWORD=change_me_strong_admin_password

# 32+ char secret for AES-256-GCM encrypted media tokens (auto-generated ephemerally if omitted in dev)
MEDIA_SECRET=change_me_random_64_hex_secret

# Comma-separated allowed origins for Next.js dev server (e.g. your host LAN IP)
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# File size limits & disk protection (MB)
MAX_CHAT_FILE_SIZE_MB=1024
MAX_P2P_FILE_SIZE_MB=1024
MAX_CHAT_FILES_BATCH=10
MIN_DISK_FREE_MB=512

# Optional Standalone Storage Root (Windows/Linux without Docker)
# STORAGE_ROOT=D:\LanShareStorage

# Optional Docker Virtual Volume overrides (default: named volumes lan_chat_db, lan_chat_uploads, etc.)
# Override any zone with a local folder (./storage/...) or a 2nd virtual disk path (/mnt/disk2/...):
# STORAGE_DB_VOL=./storage/db
# STORAGE_UPLOADS_VOL=./storage/uploads
# STORAGE_STICKERS_VOL=./storage/stickers
# STORAGE_AVATARS_VOL=./storage/avatars
# STORAGE_CACHE_VOL=./storage/video-cache
# STORAGE_CHUNKS_VOL=./storage/chunks

# Optional path to FFmpeg binary (used for browser-compatible H.264 preview of HEVC/H.265 videos).
# On Linux/Docker this is resolved automatically from system PATH.
# On standalone Windows, leave blank if ffmpeg is in System PATH, or set full path:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
